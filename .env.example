# Backend API URL
VITE_API_URL=http://localhost:8050
ADMIN_MODE_PASSWORD=go for it

# Server-side only. Keep 0 while zero out-of-pocket is an absolute requirement.
SEPARATION_CLOUD_ENABLED=0
SEPARATION_API_URL=
SEPARATION_API_KEY=
# Optional short-lived IAM identity token for manual local testing.
# Otherwise use service-account ADC with roles/run.invoker on this service.
SEPARATION_ID_TOKEN=
# Filled automatically on this host during Google Cloud setup.
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
SEPARATION_ADC_FILE=
# One backend process/host owns pause and wake for this private service.
# 0 disables control; 120 requests scale-to-zero after two idle minutes.
SEPARATION_IDLE_SHUTDOWN_SECONDS=120
SEPARATION_CLOUD_REGION=asia-southeast1
SEPARATION_CLOUD_SERVICE=vocaltune-separation
